#!/usr/bin/env bash
# Hook de pre-commit: segredos, políticas e SwiftLint nos arquivos do commit.
# Instale com scripts/install-git-hooks.sh. O CI repete tudo isso.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

branch=$(git symbolic-ref --quiet --short HEAD || true)
if [[ "$branch" == "main" && "${ALLOW_MAIN_COMMIT:-}" != "1" ]]; then
  echo "✋ Commit direto na main bloqueado. Crie uma branch: git switch -c feat/minha-mudanca" >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ gitleaks não instalado (macOS: brew install gitleaks). Ele procura segredos antes do commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner

python3 scripts/guardrails/policy_check.py --mode staged

swift_files=()
while IFS= read -r -d '' file; do swift_files+=("$file"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
if (( ${#swift_files[@]} )); then
  if command -v swiftlint >/dev/null 2>&1; then
    swiftlint lint --strict --quiet "${swift_files[@]}"
  else
    echo "aviso: SwiftLint não instalado; o CI vai rodar o lint." >&2
  fi
fi
