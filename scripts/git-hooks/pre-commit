#!/usr/bin/env bash
# Pre-commit hook: secrets, policies and SwiftLint on the staged files.
# Install with scripts/install-git-hooks.sh. CI repeats all of this.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

branch=$(git symbolic-ref --quiet --short HEAD || true)
if [[ "$branch" == "main" && "${ALLOW_MAIN_COMMIT:-}" != "1" ]]; then
  echo "✋ Direct commit to main blocked. Create a branch: git switch -c feat/my-change" >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ gitleaks is not installed (macOS: brew install gitleaks). It looks for secrets before each commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner

python3 scripts/guardrails/policy_check.py --mode staged

swift_files=()
while IFS= read -r -d '' file; do swift_files+=("$file"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
if (( ${#swift_files[@]} )); then
  if command -v swiftlint >/dev/null 2>&1; then
    swiftlint lint --strict --quiet "${swift_files[@]}"
  else
    echo "warning: SwiftLint is not installed; CI will run the lint." >&2
  fi
fi
